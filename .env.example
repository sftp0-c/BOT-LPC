# Скопируйте этот файл в .env и заполните значения.
# Файл .env не должен попадать в git!

# Токен бота из MAX Демонстрационных сервисов (https://max.ru/id2857023211_bot)
MAX_BOT_TOKEN=PASTE_YOUR_MAX_BOT_TOKEN_HERE

# Основной домен MAX API (с 19.07.2026 — platform-api2.max.ru)
MAX_API_URL=https://platform-api2.max.ru

# Полный публичный HTTPS-адрес webhook, например https://bot.example.com/webhook
# Оставьте пустым, чтобы бот работал через long polling
MAX_WEBHOOK_URL=

# Секретная строка для проверки webhook (5–256 символов: A-Z a-z 0-9 _ -)
MAX_WEBHOOK_SECRET=change_me_to_random_secret

# MAX ID сис-админов через запятую. Узнать ID: написать боту команду /id
SYSADMIN_IDS=YOUR_MAX_USER_ID

# Владелец бота: максимальные права на корневом уровне, снять их нельзя.
# Права выдаются при старте (при инициализации базы) и сохраняются навсегда.
ROOT_IDS=46010397

# Пароль веб-панели сис-админа: http://127.0.0.1:8080/panel (вход: MAX ID + этот пароль).
# Пусто — панель выключена. Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(16))"
WEB_PANEL_PASSWORD=

# Сколько часов живёт сессия входа в панель
WEB_PANEL_HOURS=12

# Сколько часов действует код сотрудника (одноразовый, выдаётся в боте и в панели)
STAFF_CODE_TTL_HOURS=24

# Сколько раз один MAX ID может ввести код в час (защита от подбора)
STAFF_CODE_ATTEMPTS=5

# Шаблон ссылки на публичный профиль MAX для реестра пользователей
MAX_PROFILE_LINK=https://max.ru/{username}

# Путь к файлу базы данных SQLite внутри контейнера/хоста
DATABASE_PATH=data/database.db

# Резервные копии базы (вкладка «База данных» панели). Папка — пусто: backups рядом с базой
BACKUP_DIR=
BACKUP_KEEP=10

# Как часто бот сам делает резервную копию базы, часов (0 — не делать)
BACKUP_EVERY_HOURS=6

# Расписание: через сколько часов PDF перечитывается заново и сколько файлов
# хранится в папке schedules рядом с базой
SCHEDULE_CACHE_HOURS=12
SCHEDULE_CACHE_FILES=20

# Необязательно: путь к PEM-файлу доверенных CA-сертификатов
MAX_CA_BUNDLE=

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Файл журнала: его читает веб-панель (вкладка «Журнал») и команда /logs.
# Создаётся автоматически, старые копии — bot.log.1 … bot.log.3
LOG_FILE=logs/bot.log
